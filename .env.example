# Claude — the orchestration brain
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs — the persona voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# MongoDB (optional locally — in-memory fallback is used if unset)
# On Railway: MONGODB_URL=${{ MongoDB.MONGO_URL }}
MONGODB_URL=

PORT=8000

# Settings view (/settings) — optional: when set, its API requires this token
ADMIN_TOKEN=

# Where settings-view uploads are stored (default: backend/uploads).
# In production point this at a persistent volume mount — or on Railway just
# mount the volume at /srv/uploads and leave this unset.
# UPLOADS_DIR=
