# Claude — the orchestration brain
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs — the persona voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# MongoDB (optional locally — in-memory fallback is used if unset)
# On Railway: MONGODB_URL=${{ MongoDB.MONGO_URL }}
MONGODB_URL=

PORT=8000

# Settings view (/settings) — optional: when set, its API requires this token
ADMIN_TOKEN=

# Where settings-view uploads are stored (default: backend/uploads).
# In production point this at a persistent volume mount — or on Railway just
# mount the volume at /srv/uploads and leave this unset.
# UPLOADS_DIR=

# Credits (optional) — API consumption is always metered into the wallet shown
# in the settings view; these enable selling credit packs there via Stripe
# Checkout. Point a Stripe webhook at POST /api/billing/stripe-webhook,
# subscribed to checkout.session.completed.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Absolute URL of this deployment, used for checkout redirects
# PUBLIC_BASE_URL=
# Price table for converting usage to credits (defaults shown; tune to your
# plans). 1 credit = CREDIT_USD dollars of metered provider cost.
# CREDIT_USD=0.01
# CLAUDE_INPUT_USD_PER_MTOK=3.0
# CLAUDE_OUTPUT_USD_PER_MTOK=15.0
# TTS_USD_PER_1K_CHARS=0.15
# AVATAR_USD_PER_MIN=0.50
